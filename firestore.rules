rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Users collection - users can read/write their own profile
    match /users/{userId} {
      allow read: if true; // Public can view user profiles
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Recipes collection - public read, signed-in users can write
    match /recipes/{recipeId} {
      // Anyone can read recipes (public viewing)
      allow read: if true;

      // Nothing bounded document size before this, so a single write could be a
      // megabyte of text, as often as someone cared to send it. Limits are generous
      // enough that no real recipe hits them.
      function withinLimits() {
        let d = request.resource.data;
        return d.title is string && d.title.size() > 0 && d.title.size() <= 200 &&
               (!('description' in d) || d.description.size() <= 2000) &&
               (!('notes' in d) || d.notes.size() <= 5000) &&
               (!('ingredients' in d) || d.ingredients.size() <= 100) &&
               (!('steps' in d) || d.steps.size() <= 100) &&
               (!('tags' in d) || d.tags.size() <= 30);
      }

      // The app renders this straight into an image element, so a javascript: or
      // data: value has no business being stored.
      function imageUrlIsSafe() {
        let d = request.resource.data;
        return !('imageUrl' in d) || d.imageUrl == null || d.imageUrl == '' ||
               d.imageUrl.matches('https://.*');
      }

      // Signed-in users can create recipes (must set createdBy to their UID)
      allow create: if request.auth != null &&
                       request.resource.data.createdBy == request.auth.uid &&
                       withinLimits() && imageUrlIsSafe();

      // Editing content is limited to the creator or an admin. Recipes predating
      // the createdBy field stay editable by any signed-in user so existing data
      // does not become read-only.
      function ownsRecipe() {
        return !('createdBy' in resource.data) ||
               resource.data.createdBy == request.auth.uid ||
               isAdmin();
      }

      // isFavorite is a shared flag on the recipe itself, so any signed-in user
      // may toggle it — but only it.
      function togglesFavoriteOnly() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['isFavorite']);
      }

      allow update: if request.auth != null &&
                       (togglesFavoriteOnly() ||
                        (ownsRecipe() && withinLimits() && imageUrlIsSafe()));

      // Users can delete their own recipes, admins can delete any
      allow delete: if request.auth != null && 
                       (resource.data.createdBy == request.auth.uid || isAdmin());
    }
    
    // Comments collection (for future implementation)
    match /recipes/{recipeId}/comments/{commentId} {
      // Anyone can read comments
      allow read: if true;
      
      // Signed-in users can create comments
      allow create: if request.auth != null;
      
      // Users can update/delete their own comments, admins can delete any
      allow update: if request.auth != null && 
                       request.auth.uid == resource.data.userId;
      allow delete: if (request.auth != null && request.auth.uid == resource.data.userId) ||
                       isAdmin();
    }
    
    // Ratings collection (for future implementation)
    match /recipes/{recipeId}/ratings/{ratingId} {
      // Anyone can read ratings
      allow read: if true;
      
      // Signed-in users can create/update their own ratings
      allow create: if request.auth != null && ratingId == request.auth.uid;
      allow update: if request.auth != null && ratingId == request.auth.uid;
      
      // Users can delete their own ratings
      allow delete: if request.auth != null && ratingId == request.auth.uid;
    }
  }
}